# syntax=docker/dockerfile:1

# Development image for compose.yml. The production image is built from Dockerfile.
# Gems are installed by bin/setup into the bundle volume, not baked into this image.

# Make sure RUBY_VERSION matches the Ruby version in .ruby-version
ARG RUBY_VERSION=4.0.7
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# Install packages needed to build gems and use the SQLite CLI
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libyaml-dev pkg-config sqlite3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV BUNDLE_PATH="/usr/local/bundle"

# Run as uid 1000, like the production image, so files written to the bind-mounted
# app (generators, logs, the database) belong to the host user rather than root.
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash && \
    mkdir -p "$BUNDLE_PATH" && chown rails:rails "$BUNDLE_PATH"
USER 1000:1000
